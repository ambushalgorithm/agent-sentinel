{
  "name": "agent-sentinel",
  "version": "1.0.0",
  "description": "Agent Sentinel - Phase 1: Honeypot demo for AI agent prompt injection",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='e2e'",
    "test:e2e": "jest --testPathPattern='e2e'",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "collectCoverageFrom": [
      "sentinel/server.js",
      "payload-server/server.js",
      "attack-lab/server.js",
      "victim-agent/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 25,
        "lines": 40,
        "statements": 40
      }
    }
  },
  "devDependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "uuid": "^9.0.0"
  }
}
